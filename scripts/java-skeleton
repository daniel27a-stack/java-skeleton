#!/usr/bin/env bash
# Wrapper to avoid typing the long docker run command every time.
# Copy it to ~/.local/bin/java-skeleton and make it executable (chmod +x).
set -euo pipefail

IMAGE="${JAVA_SKELETON_IMAGE:-ghcr.io/daniel27a-stack/java-skeleton:latest}"

exec docker run --rm -it \
  -u "$(id -u):$(id -g)" \
  -v "$PWD:/work" -w /work \
  "$IMAGE" "$@"
