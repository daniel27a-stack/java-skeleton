# Build stage: JDK + the project's Gradle wrapper.
FROM eclipse-temurin:{{javaVersion}}-jdk AS build
WORKDIR /workspace
# Build files first: this layer and the dependency resolution stay cached while only src/ changes.
COPY gradlew settings.gradle build.gradle gradle.properties ./
COPY gradle gradle
# GITHUB_ACTOR / GITHUB_TOKEN come from optional BuildKit secrets (never ARG/ENV); without
# them the build still works as long as no pirca library is used.
RUN --mount=type=secret,id=github_actor --mount=type=secret,id=github_token \
    if [ -f /run/secrets/github_actor ]; then export GITHUB_ACTOR="$(cat /run/secrets/github_actor)"; fi; \
    if [ -f /run/secrets/github_token ]; then export GITHUB_TOKEN="$(cat /run/secrets/github_token)"; fi; \
    ./gradlew --no-daemon dependencies
COPY src src
RUN --mount=type=secret,id=github_actor --mount=type=secret,id=github_token \
    if [ -f /run/secrets/github_actor ]; then export GITHUB_ACTOR="$(cat /run/secrets/github_actor)"; fi; \
    if [ -f /run/secrets/github_token ]; then export GITHUB_TOKEN="$(cat /run/secrets/github_token)"; fi; \
    ./gradlew --no-daemon bootJar \
 && java -Djarmode=tools -jar build/libs/app.jar extract --layers --destination build/extracted

# Runtime stage: JRE only, non-root, Spring Boot layers.
FROM eclipse-temurin:{{javaVersion}}-jre
RUN groupadd --system app && useradd --system --gid app --no-create-home app
WORKDIR /app
COPY --from=build /workspace/build/extracted/dependencies/ ./
COPY --from=build /workspace/build/extracted/spring-boot-loader/ ./
COPY --from=build /workspace/build/extracted/snapshot-dependencies/ ./
COPY --from=build /workspace/build/extracted/application/ ./
USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
