plugins {
    id 'java-library'
    id 'maven-publish'
    id 'jacoco'
    alias(libs.plugins.spotbugs)
    alias(libs.plugins.pitest)
}

group = '{{groupId}}'
version = '1.0.0'

apply from: 'gradle/repositories.gradle'
apply from: 'gradle/java.gradle'
